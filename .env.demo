# Loaded by `vite build --mode demo` (see package.json "build:demo").
#
# A demo build answers every API call in the browser from the fixtures in
# src/demo/fixtures, because a static deployment has no API behind it.
#
# This file is committed on purpose. It holds no secret: the passcode below
# gates invented data on a throwaway deployment, and it ships inside the bundle
# either way, where anyone who opens the page can read it.
VITE_DEMO_MODE=1
VITE_DEMO_PASSCODE=gopi-demo-2026
